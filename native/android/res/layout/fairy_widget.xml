<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fairy_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fairy_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/fairy_image"
        android:layout_width="64dp"
        android:layout_height="74dp"
        android:contentDescription="Asha"
        android:scaleType="fitCenter"
        android:src="@drawable/fairy_idle" />

    <TextView
        android:id="@+id/fairy_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="I'm right here. Tap to open Asha."
        android:textColor="#1C1915"
        android:textSize="15sp" />
</LinearLayout>
