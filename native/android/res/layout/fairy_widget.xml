<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fairy_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fairy_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/fairy_image"
        android:layout_width="64dp"
        android:layout_height="74dp"
        android:contentDescription="Asha"
        android:scaleType="fitCenter"
        android:src="@drawable/fairy_idle" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/fairy_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="I'm right here. Tap to open Asha."
            android:textColor="#33210F"
            android:textSize="15sp" />

        <!-- shown only while a reminder is ringing -->
        <LinearLayout
            android:id="@+id/fairy_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/fairy_taken"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/fairy_btn_main"
                android:text="Taken"
                android:textAllCaps="false"
                android:textColor="#3A1F08"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/fairy_later"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/fairy_btn_quiet"
                android:text="10 min later"
                android:textAllCaps="false"
                android:textColor="#5A3214"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
