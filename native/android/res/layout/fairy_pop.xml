<?xml version="1.0" encoding="utf-8"?>
<!-- The fairy flies onto the screen at reminder time, over whatever app is open, with big Taken / Later buttons. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pop_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="96dp">

    <LinearLayout
        android:id="@+id/pop_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fairy_pop_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="64dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/pop_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#33210F"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pop_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:maxLines="4"
            android:textColor="#5A4632"
            android:textSize="19sp" />

        <ImageView
            android:id="@+id/pop_photo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:contentDescription="Medicine photo"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <Button
            android:id="@+id/pop_taken"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/fairy_btn_main"
            android:textAllCaps="false"
            android:textColor="#3A1F08"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pop_later"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/fairy_btn_quiet"
            android:textAllCaps="false"
            android:textColor="#5A3214"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/pop_fairy"
        android:layout_width="128dp"
        android:layout_height="150dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="-96dp"
        android:contentDescription="Asha"
        android:elevation="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/fairy_wave" />
</FrameLayout>
